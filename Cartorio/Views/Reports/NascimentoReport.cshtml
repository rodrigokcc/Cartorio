@model IEnumerable<Cartorio.Data.Nascimento>

@{
    Layout = null;
    var startDate = ViewBag.StartDate?.ToString("dd/MM/yyyy") ?? "N/A";
    var endDate = ViewBag.EndDate?.ToString("dd/MM/yyyy") ?? "N/A";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Relatório de Nascimentos</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            color: #333;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #15A6B7;
            padding-bottom: 15px;
        }

        .report-title {
            color: #15A6B7;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .report-period {
            font-size: 16px;
            color: #666;
            margin-bottom: 5px;
        }

        .report-logo {
            margin-bottom: 15px;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

            .table th {
                background-color: #15A6B7;
                color: white;
                padding: 10px;
                text-align: left;
            }

            .table td {
                padding: 8px;
                border-bottom: 1px solid #ddd;
            }

            .table tr:nth-child(even) {
                background-color: #f2f2f2;
            }

            .table tr:hover {
                background-color: #e6f7f9;
            }

        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: #666;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="report-title">Relatório de Nascimentos</div>
        <div class="report-period">Período: @startDate a @endDate</div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>
                    Data do Registro
                 
                </th>
                <th>Data de Nascimento
                   
                </th>
                <th>
                    Nome do Regsitrado
                   
                </th>
                <th>
                    Nome do Pai
                  
                </th>
                <th>
                    Nome da Mãe
                 
                </th>
                <th>
                    Data de Nascimento do Pai
                   
                </th>
                <th>
                    Data de Nascimento da Mãe
                 </th>
                <th>
                    CPF do Pai

                </th>
                <th>
                    CPF da Mãe
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.DataDoRegistro.ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @item.DataDeNascimento.ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NomeDoRegistrado)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NomeDoPai)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NomeDaMae)
                    </td>
                    <td>
                        @(item.DataDeNascimentoDoPai.HasValue ? item.DataDeNascimentoDoPai.Value.ToString("dd/MM/yyyy") : "")
                    </td>
                    <td>
                        @(item.DataDeNascimentoDaMae.HasValue ? item.DataDeNascimentoDaMae.Value.ToString("dd/MM/yyyy") : "")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CpfDoPai)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CpfDaMae)
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="footer">
        <p>Sistema desenvolvido por DeMaria - Versão 1.0.0</p>
        <p>Relatório gerado em @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
</body>
</html>