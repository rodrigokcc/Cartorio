@model Casamento

@{
    ViewData["Title"] = "Registro de Casamento";
}

<h1 class="text-center text-primary-custom">Registro de Casamento</h1>

<div class="card shadow mt-4 mx-auto" style="max-width: 800px;">
    <div class="card-body">
        <h4 class="card-title text-center">Preencha os dados abaixo</h4>
        <hr />
        <form asp-action="AddCasamento" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDoRegistro" class="control-label">Data do Registro</label>
                        <input asp-for="DataDoRegistro" class="form-control" type="date" />
                        <span asp-validation-for="DataDoRegistro" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDoCasamento" class="control-label">Data do Casamento</label>
                        <input asp-for="DataDoCasamento" class="form-control" type="date" />
                        <span asp-validation-for="DataDoCasamento" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <br />
            <h4 class="card-title text-center">Primeiro Cônjuge</h4>
            <hr />
            <div class="form-group">
                <label asp-for="NomeConjuge1" class="control-label">Nome do Cônjuge um</label>
                <input asp-for="NomeConjuge1" class="form-control" />
                <span asp-validation-for="NomeConjuge1" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoConjuge1" class="control-label">Data de Nascimento</label>
                        <input asp-for="DataDeNascimentoConjuge1" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoConjuge1" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CpfConjuge1" class="control-label">CPF</label>
                        <input asp-for="CpfConjuge1" class="form-control" />
                        <span asp-validation-for="CpfConjuge1" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="NomeDoPaiConjuge1" class="control-label">Nome do Pai Cônjuge um</label>
                <input asp-for="NomeDoPaiConjuge1" class="form-control" />
                <span asp-validation-for="NomeDoPaiConjuge1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NomeDaMaeConjuge1" class="control-label">Nome da Mãe Cônjuge um</label>
                <input asp-for="NomeDaMaeConjuge1" class="form-control" />
                <span asp-validation-for="NomeDaMaeConjuge1" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CpfDoPaiConjuge1" class="control-label">CPF do Pai Cônjuge um</label>
                        <input asp-for="CpfDoPaiConjuge1" class="form-control" />
                        <span asp-validation-for="CpfDoPaiConjuge1" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CpfDaMaeConjuge1" class="control-label">CPF da Mãe Cônjuge um</label>
                        <input asp-for="CpfDaMaeConjuge1" class="form-control" />
                        <span asp-validation-for="CpfDaMaeConjuge1" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoDoPaiConjuge1" class="control-label">Data de Nascimento do Pai</label>
                        <input asp-for="DataDeNascimentoDoPaiConjuge1" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoDoPaiConjuge1" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoDaMaeConjuge1" class="control-label">Data de Nascimento da Mãe</label>
                        <input asp-for="DataDeNascimentoDaMaeConjuge1" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoDaMaeConjuge1" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <br />
            <h4 class="card-title text-center">Segundo Cônjuge</h4>
            <hr />
            <div class="form-group">
                <label asp-for="NomeConjuge2" class="control-label">Nome do Cônjuge 2</label>
                <input asp-for="NomeConjuge2" class="form-control" />
                <span asp-validation-for="NomeConjuge2" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoConjuge2" class="control-label">Data de Nascimento</label>
                        <input asp-for="DataDeNascimentoConjuge2" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoConjuge2" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CpfConjuge2" class="control-label">CPF</label>
                        <input asp-for="CpfConjuge2" class="form-control" />
                        <span asp-validation-for="CpfConjuge2" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="NomeDoPaiConjuge2" class="control-label">Nome do Pai Cônjuge dois</label>
                <input asp-for="NomeDoPaiConjuge2" class="form-control" />
                <span asp-validation-for="NomeDoPaiConjuge2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NomeDaMaeConjuge2" class="control-label">Nome da Mãe Cônjuge dois</label>
                <input asp-for="NomeDaMaeConjuge2" class="form-control" />
                <span asp-validation-for="NomeDaMaeConjuge2" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CpfDoPaiConjuge2" class="control-label">CPF do Pai Cônjuge dois</label>
                        <input asp-for="CpfDoPaiConjuge2" class="form-control" />
                        <span asp-validation-for="CpfDoPaiConjuge2" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CpfDaMaeConjuge2" class="control-label">CPF da Mãe Cônjuge dois</label>
                        <input asp-for="CpfDaMaeConjuge2" class="form-control" />
                        <span asp-validation-for="CpfDaMaeConjuge2" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoDoPaiConjuge2" class="control-label">Data de Nascimento do Pai</label>
                        <input asp-for="DataDeNascimentoDoPaiConjuge2" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoDoPaiConjuge2" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoDaMaeConjuge2" class="control-label">Data de Nascimento da Mãe</label>
                        <input asp-for="DataDeNascimentoDaMaeConjuge2" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoDaMaeConjuge2" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <br />
            <div class="form-group text-center">
                <input type="submit" value="Registrar" class="btn btn-success btn-lg" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
