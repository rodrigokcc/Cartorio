@model Obito

@{
    ViewData["Title"] = "Registro de Óbito";
}

<h1 class="text-center text-primary-custom">Registro de Óbito</h1>

<div class="card shadow mt-4 mx-auto" style="max-width: 600px;">
    <div class="card-body">
        <h4 class="card-title text-center">Preencha os dados abaixo</h4>
        <hr />
        <form asp-action="AddObito" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDoRegistro" class="control-label">Data do Registro</label>
                        <input asp-for="DataDoRegistro" class="form-control" type="date" />
                        <span asp-validation-for="DataDoRegistro" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDoObito" class="control-label">Data do Óbito</label>
                        <input asp-for="DataDoObito" class="form-control" type="date" />
                        <span asp-validation-for="DataDoObito" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="NomeDoFalecido" class="control-label">Nome do Falecido</label>
                <input asp-for="NomeDoFalecido" class="form-control" />
                <span asp-validation-for="NomeDoFalecido" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataDeNascimento" class="control-label">Data de Nascimento</label>
                <input asp-for="DataDeNascimento" class="form-control" type="date" />
                <span asp-validation-for="DataDeNascimento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NomeDoPai" class="control-label">Nome do Pai</label>
                <input asp-for="NomeDoPai" class="form-control" />
                <span asp-validation-for="NomeDoPai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NomeDaMae" class="control-label">Nome da Mãe</label>
                <input asp-for="NomeDaMae" class="form-control" />
                <span asp-validation-for="NomeDaMae" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoDoPai" class="control-label">Data de Nascimento do Pai</label>
                        <input asp-for="DataDeNascimentoDoPai" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoDoPai" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DataDeNascimentoDaMae" class="control-label">Data de Nascimento da Mãe</label>
                        <input asp-for="DataDeNascimentoDaMae" class="form-control" type="date" />
                        <span asp-validation-for="DataDeNascimentoDaMae" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <br />
            <div class="form-group text-center">
                <input type="submit" value="Registrar" class="btn btn-success btn-lg" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
